apiVersion: v1
  kind: Secret
  metadata:
    name: acadion-secrets
    namespace: acadion
  type: Opaque
  stringData:
    DATABASE_URL: "postgresql://postgres:postgres@postgres:5432/cursos?schema=public"
    JWT_SECRET: "CHANGE_ME"
    OPENAI_API_KEY: "CHANGE_ME"
    GOOGLE_CLIENT_ID: "CHANGE_ME"
    GOOGLE_CLIENT_SECRET: "CHANGE_ME"