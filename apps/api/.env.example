# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5588/cursos?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:8001/api/v1/auth/google/callback"

# Frontend URL (for CORS and redirects)
FRONTEND_URL="http://localhost:8000"

# AWS SES (Email)
AWS_SES_REGION="us-east-1"
AWS_SES_ACCESS_KEY_ID="your-aws-ses-access-key-id"
AWS_SES_SECRET_ACCESS_KEY="your-aws-ses-secret-access-key"
AWS_SES_FROM_EMAIL="noreply@acadion.ai"

# OpenAI (course generation pipeline)
OPENAI_API_KEY="your-openai-api-key"

# DeepSeek (LLM-as-judge for the input guardrails and their evals)
# OpenAI-compatible API. Leave the key empty to run with the deterministic
# layer only — the judge evals then self-skip instead of failing.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_JUDGE_MODEL="deepseek-chat"

# Guardrails (chat-box input)
GUARDRAILS_ENABLED="true"            # master switch for the whole chain
GUARDRAILS_JUDGE_ENABLED="false"     # stage 2; needs DEEPSEEK_API_KEY
GUARDRAILS_MAX_INPUT_CHARS=2000      # per free-text field
GUARDRAILS_JUDGE_FAIL_OPEN="true"    # allow input when the judge is unreachable

# Evals
EVAL_MIN_PASS_RATE=0.8               # floor for judge/dataset agreement

# Server
PORT=8001
