generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Component {
  id               Int               @id @default(autoincrement())
  key              String            @default(uuid()) @db.Uuid
  name             String
  description      String?
  properties       Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  version          Int               @default(1)
  internalName     String
  type             ComponentType     @default(static)
  subtype          ComponentSubtype  @default(content)
  courseComponents CourseComponent[]

  @@map("components")
}

model CourseComponent {
  id          Int       @id @default(autoincrement())
  courseId    Int       @map("course_id")
  componentId Int       @map("component_id")
  module      Int
  unit        Int
  sequence    Int
  data        Json?
  userId      String    @map("user_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("course_components")
}

model Organization {
  id        Int                @id @default(autoincrement())
  key       String             @default(uuid()) @db.Uuid
  name      String
  slug      String             @unique
  logo      String?
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @default(now()) @updatedAt @map("updated_at")
  courses   Course[]
  users     UserOrganization[]

  @@map("organizations")
}

model UserOrganization {
  userId       String       @map("user_id") @db.Uuid
  orgId        Int          @map("org_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, orgId])
  @@map("users_organizations")
}

model Course {
  id               Int               @id @default(autoincrement())
  key              String            @default(uuid()) @db.Uuid
  title            String?
  orgId            Int?              @map("org_id")
  userId           String            @map("user_id") @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  input            Json?
  output           Json?
  status           CourseStatus      @default(draft)
  conversations    Conversation[]
  courseComponents CourseComponent[]
  steps            CourseStep[]
  organization     Organization?     @relation(fields: [orgId], references: [id])
  user             User              @relation("UserCourses", fields: [userId], references: [id], onDelete: Cascade)

  @@map("courses")
}

model CourseStep {
  id               Int        @id @default(autoincrement())
  courseId         Int        @map("course_id")
  status           StepStatus @default(pending)
  payload          Json?
  error            Json?
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at")
  type             StepType
  completionTokens Int?       @map("completion_tokens")
  promptTokens     Int?       @map("prompt_tokens")
  course           Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("course_steps")
}

model Conversation {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  title      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  isArchived Boolean   @default(false) @map("is_archived")
  courseId   Int?      @map("course_id")
  course     Course?   @relation(fields: [courseId], references: [id])
  user       User      @relation("UserConversations", fields: [userId], references: [id], onDelete: Cascade)
  messages   Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String
  createdAt      DateTime     @default(now()) @map("created_at")
  sequence       Int          @default(0)
  modelName      String?      @map("model_name")
  tokensUsed     Int?         @map("tokens_used")
  metadata       Json?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model User {
  id               String             @id @default(uuid()) @db.Uuid
  name             String?
  email            String             @unique
  emailVerified    DateTime?          @map("email_verified")
  image            String?
  password         String?
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at")
  accounts         Account[]
  conversations    Conversation[]     @relation("UserConversations")
  courseComponents CourseComponent[]
  courses          Course[]           @relation("UserCourses")
  sessions         Session[]
  organizations    UserOrganization[]

  @@map("users")
}

model Account {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum ComponentType {
  static
  interactive
  evaluation

  @@map("component_type")
}

enum ComponentSubtype {
  content
  exercise
  navigation

  @@map("component_subtype")
}

enum CourseStatus {
  draft
  generating
  completed
  failed

  @@map("course_status")
}

enum StepStatus {
  pending
  running
  completed
  failed

  @@map("step_status")
}

enum StepType {
  generating_index
  generating_objectives
  generating_intro_unit
  generating_content_unit
  generating_module_evaluation
  generating_course_evaluation

  @@map("step_type")
}

enum MessageRole {
  user
  assistant
  system

  @@map("message_role")
}
